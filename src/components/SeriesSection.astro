---
import type { CollectionEntry } from 'astro:content'
import { SeriesGroup } from '~/utils'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props

const seriesGroup = await SeriesGroup.build(posts)
---

<ul class="flex flex-wrap gap-2 mt-4">
  {
    seriesGroup.sortCollationsMostRecent().map((series) => (
      <li>
        <a href={series.url} class="pill">
          {series.title}
          <span class="text-foreground/35 text-[13px]">{series.entries.length}</span>
        </a>
      </li>
    ))
  }
</ul>
