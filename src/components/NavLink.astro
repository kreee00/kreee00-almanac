---
import type { NavLink } from '~/types'

interface Props {
  link: NavLink
}

const { link } = Astro.props
const { pathname } = Astro.url

const isActive =
  !link.external &&
  (pathname === link.url || (link.url !== '/' && pathname.startsWith(link.url)))
---

<a
  class:list={[
    'px-3 py-1.5 rounded-lg text-[15px] hover:bg-foreground/5',
    isActive ? 'text-foreground! font-medium' : 'text-foreground/55 hover:text-foreground!',
  ]}
  aria-current={isActive ? 'page' : undefined}
  rel={link.external ? 'noopener noreferrer' : undefined}
  target={link.external ? '_blank' : undefined}
  href={link.url}
>
  {link.name}{link.external && <span class="text-foreground/40"> ↗</span>}
</a>
