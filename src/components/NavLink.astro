---
import type { NavLink } from '~/types'

interface Props {
  link: NavLink
}

const { link } = Astro.props
const { pathname } = Astro.url

const isActive = pathname === link.url || (link.url !== '/' && pathname.startsWith(link.url))
---

<a
  class={`text-[13px] font-semibold tracking-wide uppercase transition-all duration-200 relative pb-1 ${
    isActive 
      ? 'text-accent' 
      : 'text-foreground/40 hover:text-foreground'
  }`}
  rel={link.external ? 'noopener noreferrer' : undefined}
  target={link.external ? '_blank' : undefined}
  href={link.url}
>
  {link.name}
  {isActive && (
    <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-accent shadow-[0_0_8px_var(--theme-accent)]"></span>
  )}
</a>
