---
import type { FrontmatterImage } from '~/types'
import { Image } from 'astro:assets'

interface Props {
  avatarImage?: FrontmatterImage
}
const { avatarImage } = Astro.props
---

<div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 p-6 rounded-xl border border-separator/60">
  {
    avatarImage && (
      <Image
        src={avatarImage.src}
        alt={avatarImage.alt}
        class="rounded-full size-16 aspect-square object-cover shrink-0"
        widths={[128]}
        height={64}
        width={64}
      />
    )
  }
  <div class="prose max-w-none text-center sm:text-left [&>p]:my-0! [&>p]:text-[16px]! [&>p]:text-foreground/70!">
    <slot />
  </div>
</div>
