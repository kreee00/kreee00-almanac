---
import siteConfig from '~/site.config'
import SocialLinks from '~/components/SocialLinks.astro'
---

<footer
  class="mt-20 pt-8 flex flex-col-reverse sm:flex-row items-center justify-between gap-4 text-[14px] text-foreground/45 border-t border-separator/50"
>
  <span>
    &copy; {new Date().getFullYear()} {siteConfig.author}
  </span>
  {siteConfig.socialLinks && <SocialLinks socialLinks={siteConfig.socialLinks} />}
</footer>
