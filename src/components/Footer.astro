---
import siteConfig from '~/site.config'
import SocialLinks from '~/components/SocialLinks.astro'
---

<footer
  class="mt-32 pb-16 grow-0 flex flex-col gap-10 items-center justify-between max-w-full text-[13px] font-medium text-foreground/40 border-t border-separator/10 pt-16"
>
  {siteConfig.socialLinks && <SocialLinks socialLinks={siteConfig.socialLinks} />}
  
  <div class="flex flex-col md:flex-row items-center gap-4">
    <span class="tracking-wide uppercase">
      {siteConfig.author} &copy; {new Date().getFullYear()}
    </span>
    <span class="hidden md:block opacity-20">|</span>
    <div class="flex items-center gap-1 uppercase tracking-wide">
      <span>Designed for precise aesthetics</span>
    </div>
  </div>
</footer>
