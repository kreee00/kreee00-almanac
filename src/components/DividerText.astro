---
interface Props {
  text: string
}
const { text } = Astro.props
---

<div class="flex items-center gap-6 my-16">
  <div class="h-px bg-separator/20 flex-1"></div>
  <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-foreground/30 whitespace-nowrap">{text}</span>
  <div class="h-px bg-separator/20 flex-1"></div>
</div>
