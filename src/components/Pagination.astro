---
interface Props {
  prevLink?: string
  prevText?: string
  nextLink?: string
  nextText?: string
}

const { prevLink, prevText, nextLink, nextText } = Astro.props
---

<nav class="mt-8 flex flex-wrap gap-3 justify-between" aria-label="Pagination">
  {
    prevLink && (
      <a href={prevLink} class="button-secondary">
        ← {prevText || 'Previous'}
      </a>
    )
  }
  {
    nextLink && (
      <a href={nextLink} class="button-secondary ml-auto">
        {nextText || 'Next'} →
      </a>
    )
  }
</nav>
