---
import IconChevronsLeft from '~/icons/chevrons-left.svg'
import IconChevronsRight from '~/icons/chevrons-right.svg'

interface Props {
  prevLink?: string
  prevText?: string
  nextLink?: string
  nextText?: string
}

const { prevLink, prevText, nextLink, nextText } = Astro.props
---

<div class="my-16 flex flex-row flex-wrap gap-6 justify-center">
  {
    prevLink && (
      <a
        href={prevLink}
        aria-label="Previous Page"
        class="inline-flex items-center gap-2 text-[13px] font-bold uppercase tracking-widest text-foreground/40 hover:text-accent transition-all duration-200"
      >
        <IconChevronsLeft class="size-4" />
        {prevText || 'Previous'}
      </a>
    )
  }
  {
    nextLink && (
      <a
        href={nextLink}
        aria-label="Next Page"
        class:list={[
          'inline-flex items-center gap-2 text-[13px] font-bold uppercase tracking-widest text-foreground/40 hover:text-accent transition-all duration-200',
          prevLink && 'ml-auto',
        ]}
      >
        {nextText || 'Next'}
        <IconChevronsRight class="size-4" />
      </a>
    )
  }
</div>
