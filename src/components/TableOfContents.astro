---
import type { MarkdownHeading } from 'astro'
import TOCHeading from '~/components/TableOfContentsHeading.astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props

const filteredHeadings = headings.filter(({ depth }) => depth >= 2 && depth <= 3)
---

<nav class="toc hidden xl:block w-full">
  <h2 class="text-[11px] font-bold uppercase tracking-[0.2em] text-foreground/30 mb-6">
    On this page
  </h2>
  <ul class="flex flex-col gap-3">
    {filteredHeadings.map((heading) => <TOCHeading heading={heading} />)}
  </ul>
</nav>

<script>
  function initTOC() {
    const anchors = document.querySelectorAll('h2[id], h3[id]')
    const links = document.querySelectorAll('.toc ul li')
    
    if (anchors.length === 0 || links.length === 0) return;

    window.addEventListener('scroll', () => {
      let scrollTop = window.scrollY
      let highlighted = false
      
      for (let i = anchors.length - 1; i >= 0; i--) {
        const anchor = anchors[i] as HTMLElement
        if (!highlighted && scrollTop > anchor.offsetTop - 120) {
          links[i]?.classList.add('active-heading')
          highlighted = true
        } else {
          links[i]?.classList.remove('active-heading')
        }
      }
    }, { passive: true })
  }

  initTOC();
  document.addEventListener('astro:page-load', initTOC);
</script>
