---
interface Props {
  title?: string
  titlePieces?: string[]
}

const { title, titlePieces } = Astro.props

const splitPath: string[] = Astro.url.pathname
  .split('/')
  .filter(Boolean)
  .map((part) => decodeURIComponent(part))

const pieces = titlePieces ?? splitPath

if (pieces.length === 0) {
  pieces.push('home')
}
---

<h1 class="pt-8 pb-2 text-[28px] sm:text-[32px] font-bold tracking-tight text-foreground flex flex-wrap gap-x-2">
  {
    title ? (
      title
    ) : (
      pieces.map((part, i) => (
        <span class={i < pieces.length - 1 ? 'text-foreground/40 font-medium' : ''}>
          <span class="text-accent font-mono font-normal">/</span>
          {part}
        </span>
      ))
    )
  }
</h1>
