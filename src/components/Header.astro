---
import siteConfig from '~/site.config'
import LightDarkAutoButton from '~/components/LightDarkAutoButton.astro'
import Search from '~/components/Search.astro'
import SelectTheme from '~/components/SelectTheme.astro'
import NavLink from '~/components/NavLink.astro'

const lightDarkAutoTheme = siteConfig.themes.mode === 'light-dark-auto'
const selectTheme =
  siteConfig.themes.mode === 'select' && siteConfig.themes.include.length > 1

---

<header class="py-5 mb-6">
  <div class="relative flex items-center justify-between gap-4">
    <a
      id="logo"
      href="/"
      class="text-[16px] font-semibold tracking-tight text-foreground! hover:opacity-70 flex items-center gap-1.5 whitespace-nowrap"
    >
      <span class="text-accent font-mono">/</span>
      {siteConfig.title}
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav aria-label="Menu" class="hidden sm:block mr-2">
        <ul class="flex items-center gap-1">
          {
            siteConfig.navLinks.map((link) => (
              <li>
                <NavLink link={link} />
              </li>
            ))
          }
        </ul>
      </nav>

      <Search trailingSlashes={siteConfig.trailingSlashes} />
      {lightDarkAutoTheme && <LightDarkAutoButton />}
      {selectTheme && <SelectTheme />}

      <nav id="nav-mobile" aria-label="Menu" class="sm:hidden relative">
        <button
          id="nav-mobile-button"
          class="icon-button"
          type="button"
          aria-expanded="false"
          aria-controls="nav-mobile-list"
        >
          <span class="sr-only">Open menu</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="20" y2="15"></line></svg>
        </button>
        <ul
          id="nav-mobile-list"
          class="invisible absolute right-0 top-full mt-2 w-44 bg-background border border-separator/40 shadow-lg rounded-xl p-1.5 z-50"
        >
          {
            siteConfig.navLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  target={link.external ? '_blank' : undefined}
                  class="block px-3 py-2 rounded-lg text-[15px] text-foreground/80 hover:bg-foreground/5 hover:text-foreground"
                >
                  {link.name}{link.external && <span class="text-foreground/40"> ↗</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  function initNav() {
    const navMobileButton = document.getElementById('nav-mobile-button')
    const navMobileList = document.getElementById('nav-mobile-list')
    
    if (!navMobileButton || !navMobileList) return;

    const toggleNavMobileMenu = (action: 'on' | 'off' | 'toggle') => {
      let isNowOpen: boolean = false
      if (action === 'on') {
        isNowOpen = true
        navMobileList.classList.remove('invisible', 'opacity-0', 'scale-95')
      } else if (action === 'off') {
        isNowOpen = false
        navMobileList.classList.add('invisible', 'opacity-0', 'scale-95')
      } else {
        isNowOpen = navMobileList.classList.toggle('invisible') === false
      }
      
      navMobileButton.setAttribute('aria-expanded', isNowOpen ? 'true' : 'false')
    }

    navMobileButton.addEventListener('click', (e) => {
      e.stopPropagation()
      toggleNavMobileMenu('toggle')
    })

    document.addEventListener('click', () => toggleNavMobileMenu('off'))
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
