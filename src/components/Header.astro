---
import siteConfig from '~/site.config'
import LightDarkAutoButton from '~/components/LightDarkAutoButton.astro'
import Search from '~/components/Search.astro'
import SelectTheme from '~/components/SelectTheme.astro'
import NavLink from '~/components/NavLink.astro'

const lightDarkAutoTheme = siteConfig.themes.mode === 'light-dark-auto'
const selectTheme =
  siteConfig.themes.mode === 'select' && siteConfig.themes.include.length > 1

// Extract initials for a subtle logo mark
const initials = siteConfig.title
  .split(/['\s]/)
  .filter(Boolean)
  .map(word => word[0])
  .join('')
  .toLowerCase()
---

<header class="py-6 mb-8">
  <div class="relative flex items-center justify-between">
    <a
      id="logo"
      href="/"
      class="text-[17px] font-bold tracking-tight text-foreground hover:opacity-80 transition-all flex items-center gap-2 group"
    >
      <span class="text-accent group-hover:shadow-[0_0_12px_var(--theme-accent)] transition-all">/</span>
      {siteConfig.title}
    </a>
    
    <div class="flex items-center gap-8">
      <nav aria-label="Menu" class="hidden sm:block">
        <ul class="flex items-center gap-8">
          {
            siteConfig.navLinks.map((link) => (
              <li>
                <NavLink link={link} />
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-4 border-l border-separator/20 pl-6">
        <Search trailingSlashes={siteConfig.trailingSlashes} />
        {lightDarkAutoTheme && <LightDarkAutoButton />}
        {selectTheme && <SelectTheme />}
        
        <nav id="nav-mobile" aria-label="Menu" class="sm:hidden relative">
          <button
            id="nav-mobile-button"
            class="p-2 rounded-lg hover:bg-foreground/5 transition-colors"
            type="button"
            aria-expanded="false"
            aria-controls="nav-mobile-list"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          </button>
          <ul
            id="nav-mobile-list"
            class="invisible absolute right-0 top-full mt-2 w-48 bg-background/95 backdrop-blur-xl border border-separator/20 shadow-2xl rounded-xl p-2 z-50 overflow-hidden transition-all duration-200"
          >
            {
              siteConfig.navLinks.map((link) => (
                <li>
                  <a
                    href={link.url}
                    class="block px-4 py-2 rounded-lg hover:bg-accent hover:text-black transition-colors text-[13px] font-bold uppercase tracking-wider"
                  >
                    {link.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  function initNav() {
    const navMobileButton = document.getElementById('nav-mobile-button')
    const navMobileList = document.getElementById('nav-mobile-list')
    
    if (!navMobileButton || !navMobileList) return;

    const toggleNavMobileMenu = (action: 'on' | 'off' | 'toggle') => {
      let isNowOpen: boolean = false
      if (action === 'on') {
        isNowOpen = true
        navMobileList.classList.remove('invisible', 'opacity-0', 'scale-95')
      } else if (action === 'off') {
        isNowOpen = false
        navMobileList.classList.add('invisible', 'opacity-0', 'scale-95')
      } else {
        isNowOpen = navMobileList.classList.toggle('invisible') === false
      }
      
      navMobileButton.setAttribute('aria-expanded', isNowOpen ? 'true' : 'false')
    }

    navMobileButton.addEventListener('click', (e) => {
      e.stopPropagation()
      toggleNavMobileMenu('toggle')
    })

    document.addEventListener('click', () => toggleNavMobileMenu('off'))
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
