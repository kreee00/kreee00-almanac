---
import type { MarkdownHeading } from 'astro'

interface Props {
  heading: MarkdownHeading
}

const {
  heading: { depth, slug, text },
} = Astro.props
---

<li class={`transition-all duration-200 ${depth === 3 ? 'ml-4' : ''}`}>
  <a
    class="text-[13px] font-medium text-foreground/40 hover:text-accent transition-colors duration-200 line-clamp-2 leading-relaxed"
    href={`#${slug}`}>{text}</a
  >
</li>

<style is:global>
  @reference "../styles/global.css";

  li.active-heading a {
    @apply text-accent font-bold;
    text-shadow: 0 0 8px rgba(0, 255, 65, 0.2);
  }
</style>
