---
import type { MarkdownHeading } from 'astro'

interface Props {
  heading: MarkdownHeading
}

const {
  heading: { depth, slug, text },
} = Astro.props
---

<li class={depth === 3 ? 'ml-4' : ''}>
  <a class="text-[15px] text-foreground/60! hover:text-foreground! leading-snug" href={`#${slug}`}>
    {text}
  </a>
</li>
