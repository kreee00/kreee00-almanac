---
import { Image } from 'astro:assets'
import siteConfig from '~/site.config'
import type { FrontmatterImage } from '~/types'

interface Props {
  avatarImage?: FrontmatterImage
}
const { avatarImage } = Astro.props
---

<div class="pt-10 pb-4">
  <div class="flex flex-col sm:flex-row items-start gap-6 sm:gap-8">
    {
      avatarImage && (
        <Image
          priority
          src={avatarImage.src}
          alt={avatarImage.alt}
          class="rounded-full size-20 sm:size-32 aspect-square object-cover shrink-0"
          widths={[256]}
          height={128}
          width={128}
        />
      )
    }
    <div>
      <div class="prose max-w-none [&>p]:my-0! [&>p+p]:mt-4! [&>p]:text-foreground/75!">
        <slot />
      </div>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/posts" class="button">
          Read the archive
        </a>
        <a
          href={siteConfig.portfolio}
          target="_blank"
          rel="noopener noreferrer"
          class="button-secondary"
        >
          More about me
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
        </a>
      </div>
    </div>
  </div>
</div>
