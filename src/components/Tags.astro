---
import type { Collation } from '~/types'

interface Props {
  tags: Collation<'posts'>[]
}

const { tags } = Astro.props
---

<div class="flex flex-wrap gap-x-3 gap-y-1 text-[14px]">
  {
    tags.map((tag) => (
      <a href={tag.url} class="text-foreground/50! hover:text-foreground!">
        #{tag.title}
      </a>
    ))
  }
</div>
