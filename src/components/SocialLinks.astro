---
import type { SocialLinks } from '~/types'
import IconGithub from '~/icons/github.svg'
import IconMastodon from '~/icons/mastodon.svg'
import IconTwitter from '~/icons/twitter.svg'
import IconLinkedin from '~/icons/linkedin.svg'
import IconBluesky from '~/icons/bluesky.svg'
import IconEmail from '~/icons/email.svg'
import IconRss from '~/icons/rss.svg'

interface Props {
  socialLinks: SocialLinks
}

const { socialLinks } = Astro.props

const links = [
  { href: socialLinks.github, label: 'GitHub', Icon: IconGithub, external: true },
  { href: socialLinks.mastodon, label: 'Mastodon', Icon: IconMastodon, external: true },
  { href: socialLinks.twitter, label: 'Twitter', Icon: IconTwitter, external: true },
  { href: socialLinks.linkedin, label: 'LinkedIn', Icon: IconLinkedin, external: true },
  { href: socialLinks.bluesky, label: 'Bluesky', Icon: IconBluesky, external: true },
  { href: socialLinks.email, label: 'Email', Icon: IconEmail, external: false },
  { href: socialLinks.rss ? '/rss.xml' : undefined, label: 'RSS', Icon: IconRss, external: false },
].filter((link) => link.href)
---

<div class="flex items-center gap-1 -mr-2">
  {
    links.map(({ href, label, Icon, external }) => (
      <a
        href={href}
        class="icon-button"
        title={label}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
      >
        <span class="sr-only">{label}</span>
        <Icon class="size-[18px]" />
      </a>
    ))
  }
</div>
