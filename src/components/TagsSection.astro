---
import type { CollectionEntry } from 'astro:content'
import { TagsGroup } from '~/utils'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props
const tagsGroup = await TagsGroup.build(posts)
---

<ul class="flex flex-wrap gap-x-4 gap-y-6 my-8">
  {
    tagsGroup.sortCollationsLargest().map((tag) => (
      <li>
        <a
          href={tag.url}
          class="flex items-center gap-3 py-2 px-4 bg-foreground/[0.03] rounded-lg border border-separator/10 hover:border-accent hover:text-accent transition-all duration-200"
        >
          <span class="text-[13px] font-bold uppercase tracking-wider">{tag.title}</span>
          <span class="text-[11px] font-bold text-foreground/30 group-hover:text-accent/60">
            {tag.entries.length}
          </span>
        </a>
      </li>
    ))
  }
</ul>
